@using Web_App.Models
@model Web_App.Models.User
@{
    ViewData["Title"] = "Удаление пользователя";
}

<h1 class="h3 mb-3">Удалить пользователя?</h1>

<dl class="row">
    <dt class="col-sm-2">ФИО</dt><dd class="col-sm-10">@Model.FullName</dd>
    <dt class="col-sm-2">Роль</dt><dd class="col-sm-10">@Model.Kind.ToDisplayString()</dd>
    <dt class="col-sm-2">Логин</dt><dd class="col-sm-10">@(Model.HasAccount ? Model.Login : "—")</dd>
</dl>

<form asp-action="DeleteUser" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Users" class="btn btn-secondary">Отмена</a>
</form>
